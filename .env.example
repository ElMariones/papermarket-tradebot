# TradeBOT environment variables (copy to .env for local use; set on Fly via
# fly.toml [env] for non-secret values or `fly secrets set` for secrets).
#
# None of these are secrets today — paper trading needs no API keys or wallet.
# The file exists so the configuration surface is documented in one place.

# Where the SQLite ledger lives.
#   Local default (if unset): ~/.polymarket-paper/portfolio.db
#   Fly: /data/portfolio.db (a mounted persistent volume)
TRADEBOT_DB_PATH=/data/portfolio.db

# HTTP port the dashboard binds. Fly injects this; locally defaults to 8765.
PORT=8080

# Run the agent loop inside the web process (1) or expect a separate worker (0).
TRADEBOT_STANDALONE=1

# Starting paper balance used only when a portfolio is first created.
TRADEBOT_START_BALANCE=200

# Portfolio name (lets you run more than one).
TRADEBOT_PORTFOLIO=default

# Worker-only: auto-start trading on boot unless dashboard left it paused.
AGENT_AUTOSTART=1

# --- Access control ---
# Accounts are the real system now: create them with
#   python3 backend/create_user.py <username> <password> [--role admin]
# Login sessions are DB-backed (no secret env var needed). Session lifetime is
# the SESSION_TTL_DAYS constant in backend/auth.py.
#
# LEGACY fallback (deprecated): if TRADEBOT_AUTH_PASSWORD is set AND no
# accounts exist yet, the whole dashboard + API require HTTP Basic Auth like
# the old single-password releases. It is ignored once the first account is
# created. In prod set it as a Fly SECRET, not in fly.toml:
#   fly secrets set TRADEBOT_AUTH_PASSWORD=...
TRADEBOT_AUTH_USER=admin
TRADEBOT_AUTH_PASSWORD=

# How often the agent saves a performance report (seconds). Default 3600 = hourly.
TRADEBOT_REPORT_INTERVAL_SEC=3600
